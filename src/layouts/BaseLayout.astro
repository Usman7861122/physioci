---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  showComparison?: boolean;
  overlayHeader?: boolean;
}
const { title, description = 'Physio / Sci Laboratories', showComparison = true, overlayHeader = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Jost:wght@300;400;500&family=Josefin+Sans:wght@400&family=Nunito+Sans:wght@400;600;700;800&family=Playfair+Display:wght@500;700;900&family=Source+Serif+4:wght@400;500&family=Tenor+Sans&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[100] focus:bg-white focus:p-2">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer showComparison={showComparison} />
    <script>
      // Fade/slide elements in once as they enter the screen.
      const targets: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((parent) => {
        Array.from(parent.children).forEach((c, i) => {
          if (c.tagName === 'ASTRO-ISLAND') return;
          (c as HTMLElement).style.setProperty('--d', `${Math.min(i, 8) * 90}ms`);
          targets.push(c as HTMLElement);
        });
      });
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => targets.push(el));

      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
