---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'brown' | 'light';
  class?: string;
}
const { href, variant = 'primary', class: extra = '' } = Astro.props;
const styles = {
  primary: 'bg-cta text-white shadow-[0_6px_16px_rgba(6,112,204,0.28)] hover:brightness-110',
  outline: 'border-[1.5px] border-[#b58a3c] bg-white/50 text-[#6a4a12] hover:bg-white',
  brown: 'bg-[#8b6114] text-white hover:bg-[#7a5410]',
  light: 'bg-white text-gold-dark shadow-[0_6px_16px_rgba(0,0,0,0.12)] hover:bg-cream',
};
---
<a
  href={href}
  class:list={[
    'group/btn inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-7 font-nunito text-[16px] font-bold leading-none transition duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    styles[variant],
    extra,
  ]}
>
  <slot />
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
</a>
