---
import Button from './Button.astro';
import { skin } from '../../data/home';
---
<section class="relative overflow-hidden bg-[#f6eee1]" aria-labelledby="skin-title">
  <div class="mx-auto grid max-w-[1300px] items-stretch lg:grid-cols-[1fr_1fr]">
    <div class="relative min-h-[360px] overflow-hidden lg:min-h-[640px]" data-reveal="left">
      <img
        src="/images/skinsaver/ss-support.webp"
        alt="Smiling woman touching her cheek beside a GLP-1 SkinSaver pump bottle"
        width="1675"
        height="939"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover object-left"
      />
      <div class="absolute inset-y-0 right-0 hidden w-24 bg-gradient-to-r from-transparent to-[#f6eee1] lg:block" aria-hidden="true"></div>
    </div>

    <div class="px-5 py-12 lg:px-12 lg:py-16" data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">{skin.label}</p>
      <h2 id="skin-title" class="mt-2 font-jost text-[32px] font-light leading-[1.1] text-gold-deep sm:text-[46px]">{skin.title}</h2>
      <p class="mt-3 font-nunito text-[18px] font-semibold text-[#33333a]">{skin.sub}</p>
      <ul class="mt-6">
        {skin.items.map((it) => (
          <li class="group flex items-center gap-4 border-t border-gold-deep/30 py-3 transition-colors duration-300 hover:bg-white/50">
            <img src={it.icon} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 transition-transform duration-300 group-hover:scale-110" />
            <div class="font-nunito">
              <h3 class="text-[19px] font-extrabold leading-tight text-gold-deep">{it.title}</h3>
              <p class="text-[15px] leading-snug text-[#33333a]">{it.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/product/glp-1-skinsaver">Learn More</Button>
      </div>
    </div>
  </div>
</section>
