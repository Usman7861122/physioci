---
import SectionHeading from './SectionHeading.astro';
import { posts } from '../../data/home';
---
<section class="bg-white px-5 py-16 lg:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading eyebrow="Learn more" title="Blog" strong="Articles" />
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {posts.map((p) => (
        <li>
          <a href={p.href} class="group block h-full overflow-hidden rounded-[18px] border border-[#eadfca] bg-[#fbf8f2] transition duration-300 hover:-translate-y-2 hover:shadow-[0_18px_38px_rgba(90,60,20,0.16)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep">
            <div class="overflow-hidden">
              <img src={p.image} alt="" width="400" height="260" loading="lazy" class="h-[190px] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="p-5">
              <h3 class="font-jost text-[19px] font-medium leading-snug text-gold-dark">{p.title}</h3>
              <span class="mt-3 inline-flex items-center gap-1 font-nunito text-[14px] font-bold text-[#6a4a12]">
                Read more
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
