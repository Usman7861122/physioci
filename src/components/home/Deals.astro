---
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
import { deals } from '../../data/home';
---
<section class="bg-cream-2 px-5 py-16 lg:py-24" aria-labelledby="deals-title">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading eyebrow="Better together" title="Buy Three," strong="Save More" intro="Pair Sidekick with SkinSaver, or stock up and save 15%." />
    <ul class="mt-10 grid gap-6 md:grid-cols-3" data-stagger>
      {deals.map((d) => (
        <li class="group relative overflow-hidden rounded-[22px] border border-[#eadfca] bg-white shadow-[0_10px_30px_rgba(90,60,20,0.08)] transition duration-300 hover:-translate-y-2 hover:shadow-[0_22px_44px_rgba(90,60,20,0.18)]">
          <span class="absolute left-4 top-4 z-10 rounded-full bg-[#8b6114] px-3 py-1 font-nunito text-[12px] font-bold uppercase tracking-wide text-white">{d.tag}</span>
          <div class="overflow-hidden">
            <img src={d.image} alt={d.alt} width="480" height="480" loading="lazy" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <div class="p-6 text-center">
            <h3 class="font-jost text-[24px] font-medium text-gold-dark">{d.title}</h3>
            <p class="mt-1 font-nunito text-[15px] text-[#3a3a40]">{d.text}</p>
            <p class="mt-3 font-nunito text-[26px] font-extrabold text-black">{d.price}</p>
            <Button href={d.href} class="mt-4">Shop Now</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
