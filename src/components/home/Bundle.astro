---
import Button from './Button.astro';
import NatIcon from '../natures/NatIcon.astro';
import { hero } from '../../data/bundle';
---
<section class="bg-gradient-to-br from-[#f6ecdc] to-[#efdfc4] px-5 py-16 lg:py-24" aria-labelledby="home-bundle-title">
  <div class="mx-auto grid max-w-[1200px] items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">Better together</p>
      <h2 id="home-bundle-title" class="mt-2 font-jost text-[34px] font-light uppercase leading-[1.05] text-gold-deep sm:text-[48px]">
        GLP-1 Total <strong class="font-semibold">Transformation System</strong><sup class="align-super text-[0.35em]">™</sup>
      </h2>
      <p class="mt-3 font-nunito text-[17px] leading-[1.5] text-[#33291d]">{hero.highlight} <span class="font-bold">GLP-1 SIDEKICK™ + GLP-1 SkinSaver™.</span></p>
      <ul class="mt-4 max-w-[420px]">
        {hero.checks.map((c) => (
          <li class="flex items-center gap-3 border-b border-gold-deep/30 py-2 transition-transform duration-300 last:border-b-0 hover:translate-x-1.5">
            <NatIcon name={c.icon} class="h-9 w-9 shrink-0 text-gold-deep" />
            <span class="font-nunito text-[19px] text-[#2b2b33]">{c.lead} <strong class="font-extrabold text-gold-deep">{c.strong}</strong></span>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Button href="/product/glp-1-total-transformation-system">Shop the Bundle</Button>
        <p class="font-nunito text-[22px] font-extrabold text-black">$259.99</p>
      </div>
    </div>
    <img
      src="/images/bundle/bundle-gallery-1.webp"
      alt="GLP-1 Sidekick jar and GLP-1 SkinSaver pump bottle with a pink drink and a scoop of powder"
      width="1000"
      height="1000"
      loading="lazy"
      data-reveal="right"
      class="mx-auto h-auto w-full max-w-[560px] rounded-[22px] shadow-[0_18px_40px_rgba(90,60,20,0.2)]"
    />
  </div>
</section>
