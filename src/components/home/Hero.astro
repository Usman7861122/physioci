---
import Button from './Button.astro';
import { hero } from '../../data/home';
---
<section class="relative flex flex-col overflow-hidden bg-[#f8f1e4] lg:min-h-[100svh] lg:flex-row lg:items-center" aria-labelledby="home-title">
  <img
    src="/images/final-home.webp"
    alt="GLP-1 Sidekick, GLP-1 SkinSaver and Nature’s GLP-1 on a warm cream background with a white flower"
    width="1732"
    height="908"
    fetchpriority="high"
    class="hero-zoom order-2 h-[340px] w-full object-cover object-[85%_bottom] sm:h-[460px] lg:absolute lg:inset-0 lg:h-full lg:object-[center_bottom]"
  />
  <!-- soft layer on the left so the text is easy to read -->
  <div class="absolute inset-y-0 left-0 hidden w-[62%] bg-gradient-to-r from-[#f8f1e4]/90 via-[#f8f1e4]/55 to-transparent lg:block" aria-hidden="true"></div>

  <div class="relative order-1 mx-auto w-full max-w-[1200px] px-5 pb-12 pt-[190px] lg:pb-20 lg:pt-[170px]">
    <div class="max-w-[520px]" data-stagger>
      <h1 id="home-title">
        <span class="block font-tenor text-[38px] font-semibold leading-[1.1] text-gold sm:text-[56px]">Nutritional Support</span>
        <span class="mt-2 block font-tenor text-[20px] font-semibold leading-snug text-black sm:text-[28px]">for your GLP-1 Weight Loss Journey</span>
      </h1>
      <p class="mt-5 font-nunito text-[17px] leading-[1.6] text-[#33333a] sm:text-[18px]">{hero.text}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="#products">Shop Now</Button>
        <Button href="/contact-us" variant="outline">Start Physio/Sci Today</Button>
      </div>
    </div>
  </div>
</section>
