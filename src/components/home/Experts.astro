---
import Button from './Button.astro';
import { experts } from '../../data/home';
---
<section class="bg-cream-2 px-5 py-16 lg:py-24" aria-labelledby="experts-title">
  <div class="mx-auto grid max-w-[1200px] items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">{experts.label}</p>
      <h2 id="experts-title" class="mt-2 font-jost text-[32px] font-light uppercase leading-[1.08] text-gold-deep sm:text-[50px]">{experts.title}</h2>
      <p class="mt-4 max-w-[520px] font-nunito text-[17px] leading-[1.6] text-[#33333a]">{experts.text}</p>
      <div class="mt-6"><Button href="/backed-by-our-advisory-board" variant="brown">Learn More</Button></div>
    </div>
    <div class="relative mx-auto w-full max-w-[460px]" data-reveal="right">
      <div class="absolute -inset-3 -z-0 rounded-[30px] bg-gradient-to-br from-[#fcc461]/60 to-[#b77c08]/30" aria-hidden="true"></div>
      <img src={experts.image} alt="Physio/Sci medical advisor" width="544" height="635" loading="lazy" class="relative w-full rounded-[24px] bg-white object-cover shadow-[0_20px_44px_rgba(90,60,20,0.2)]" />
    </div>
  </div>
</section>
