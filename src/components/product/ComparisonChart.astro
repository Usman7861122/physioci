---
import { chart } from '../../data/sidekick';
import { assets } from '../../data/assets';
---
<section
  class="bg-cover bg-center bg-no-repeat px-4 py-14 lg:py-[72px]"
  style={`background-image:url('${assets.formulaBg}')`}
  aria-labelledby="chart-title"
>
  <div class="mx-auto max-w-[1100px]">
    <h2 id="chart-title" data-reveal class="gold-text text-center font-playfair text-[34px] font-black leading-[1.05] tracking-[-0.03em] sm:text-[56px]">
      {chart.title[0]}<br />{chart.title[1]}
    </h2>
    <p data-reveal style="--d:120ms" class="mt-3 text-center font-nunito text-[13px] font-semibold uppercase tracking-[0.3em] text-[#1b1b1b] sm:text-[18px]">
      {chart.tagline}
    </p>

    <div class="mt-8 grid items-stretch gap-4 lg:grid-cols-[1.38fr_1fr]">
      <!-- GLP-1 Sidekick -->
      <div data-reveal="left" class="flex flex-col overflow-hidden rounded-2xl border border-[#c9a45c] bg-[#fbf3df] shadow-[0_10px_30px_rgba(120,80,20,0.18)] sm:flex-row">
        <img
          src="/images/chart-sidekick-jar.webp"
          alt="GLP-1 Sidekick jar with a scoop of Red Raspberry powder"
          width="292"
          height="817"
          loading="lazy"
          class="hidden object-cover object-top sm:block sm:h-auto sm:w-[42%] sm:shrink-0"
        />
        <div class="flex-1 bg-gradient-to-b from-[#fdf6e4] to-[#f6e7c3]">
          <div class="bg-gradient-to-b from-[#c08a2b] to-[#8a5a12] px-4 py-3 text-center text-white">
            <p class="font-playfair text-[28px] font-bold leading-none sm:text-[32px]">{chart.sidekick.name}</p>
            <p class="mt-1 font-nunito text-[12px] font-semibold tracking-[0.2em] text-[#fbe9c4] sm:text-[14px]">{chart.sidekick.tag}</p>
          </div>
          <ul>
            {chart.sidekick.rows.map((r) => (
              <li class="flex items-start gap-3 border-b border-[#c9a45c]/60 px-4 py-2.5 transition-colors duration-200 hover:bg-white/50 last:border-b-0">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-[#d9a13a] to-[#a8731b] text-white">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                  <span class="sr-only">Included</span>
                </span>
                <div class="font-nunito leading-snug">
                  <p class="text-[17px] font-extrabold text-[#3b1d10]">{r.title}</p>
                  {r.lines.map((l) => <p class="text-[15px] text-[#2b2b2b]" set:html={l} />)}
                  {r.sub && <p class="text-[13px] text-[#2b2b2b]">{r.sub}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Typical powder -->
      <div data-reveal="right" class="flex flex-col overflow-hidden rounded-2xl border border-white/80 bg-[#f4f4f2] shadow-[0_10px_30px_rgba(60,60,60,0.12)] sm:flex-row">
        <img
          src="/images/chart-typical-jar.webp"
          alt="A typical white GLP-1 support powder tub with a scoop of white powder"
          width="213"
          height="808"
          loading="lazy"
          class="hidden object-cover object-top sm:block sm:h-auto sm:w-[40%] sm:shrink-0"
        />
        <div class="flex-1">
          <div class="bg-[#d9d9d7] px-4 py-3 text-center">
            <p class="font-nunito text-[20px] font-extrabold leading-tight text-[#2a2a2a] sm:text-[22px]">{chart.typical.name}</p>
            <p class="mt-1 font-nunito text-[12px] font-semibold tracking-[0.15em] text-[#2a2a2a]">{chart.typical.tag}</p>
          </div>
          <ul>
            {chart.typical.rows.map((r) => (
              <li class="flex items-start gap-3 border-b border-[#d4d4d1] px-4 py-2.5 transition-colors duration-200 hover:bg-white/60 last:border-b-0">
                {r.ok ? (
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#8d8d8d] text-white">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    <span class="sr-only">Included (limited)</span>
                  </span>
                ) : (
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#2f2f2f] text-white">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path></svg>
                    <span class="sr-only">Not included</span>
                  </span>
                )}
                <div class="font-nunito leading-snug">
                  <p class="text-[17px] font-extrabold text-[#1a1a1a]">{r.title}</p>
                  {r.lines.map((l) => <p class="text-[15px] text-[#333]" set:html={l} />)}
                  {r.sub && <p class="text-[13px] text-[#333]">{r.sub}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Benefit icons -->
    <ul data-stagger class="mt-8 grid grid-cols-2 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
      {chart.benefits.map((b) => (
        <li class="group flex flex-col items-center px-2 text-center lg:border-r lg:border-[#c9a45c]/50 lg:last:border-r-0">
          <img src={b.icon} alt="" width="116" height="82" loading="lazy" class="h-[58px] w-auto transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-110" />
          <p class="mt-2 font-nunito text-[14px] font-semibold uppercase leading-snug tracking-wide text-[#4a3213] sm:text-[16px]">
            {b.label[0]}<br />{b.label[1]}
          </p>
        </li>
      ))}
    </ul>

    <!-- Banner -->
    <div data-reveal="zoom" class="mt-8 rounded-md bg-gradient-to-b from-[#c08a2b] to-[#8a5a12] px-4 py-5 text-center font-jost font-medium uppercase text-white shadow-[0_8px_20px_rgba(120,80,20,0.25)]">
      <p class="text-[15px] tracking-[0.28em] sm:text-[22px]">{chart.banner[0]}</p>
      <p class="mt-1 text-[14px] tracking-[0.22em] sm:text-[24px] sm:tracking-[0.26em]">{chart.banner[1]}</p>
    </div>
  </div>
</section>
