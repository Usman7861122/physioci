---
import BuyButton from '../BuyButton.astro';
import CheckCircle from '../CheckCircle.astro';
import { assets } from '../../data/assets';

const checks = ['Losing Muscle', 'Skin Sagging', 'Nutrient Depletion'];
---
<section class="relative overflow-hidden bg-[#f3ead9]" aria-labelledby="hero-title">
  <img
    src={assets.heroBg}
    alt="GLP-1 Sidekick jar next to a glass of water, a scoop of powder and white flowers"
    width="1732"
    height="908"
    fetchpriority="high"
    class="hero-zoom absolute inset-0 h-full w-full object-cover object-[72%_center]"
  />
  <!-- soft fade so the text stays readable on small screens -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#f6efe2]/95 via-[#f6efe2]/85 to-[#f6efe2]/40 md:from-transparent md:via-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[600px] max-w-[1200px] items-center px-5 py-14 md:min-h-[720px] xl:px-0">
    <div class="max-w-[560px]" data-stagger>
      <p class="font-nunito text-[13px] font-semibold uppercase tracking-[0.3em] text-gold-dark">GLP-1 Support</p>
      <h1 id="hero-title" class="mt-2 font-jost text-[42px] font-light uppercase leading-none text-gold-deep sm:text-[64px]">
        GLP-1 Sidekick<sup class="align-super text-[0.42em]">™</sup>
      </h1>
      <p class="mt-3 font-nunito text-[18px] text-[#33291d] sm:text-[20px]">The Missing Piece of GLP-1 Weight Loss.</p>
      <p class="mt-2 inline-block rounded-md bg-gradient-to-r from-[#efd7a3]/90 to-[#f6e9cd]/60 px-3 py-1 font-nunito text-[18px] font-extrabold text-gold-dark sm:text-[21px]">
        Looking Lean and Healthy is not just about the scale!
      </p>
      <p class="mt-2 font-nunito text-[15px] font-medium text-[#8f6a2c]">
        GLP-1 Sidekick Picks Up Where Your GLP-1 Medication Left off.
      </p>

      <ul class="mt-5 max-w-[440px]">
        {checks.map((c) => (
          <li class="flex items-center gap-3 border-b border-gold-deep/50 py-3 transition-transform duration-300 hover:translate-x-1.5 last:border-b-0">
            <CheckCircle class="h-8 w-8 text-gold-deep" />
            <span class="font-nunito text-[20px] text-[#2b2b33] sm:text-[22px]">
              Stop <strong class="font-extrabold text-gold-deep">{c}</strong>
            </span>
          </li>
        ))}
      </ul>

      <p class="mt-4 font-nunito text-[14px] text-[#2b2b33]">
        <strong class="font-extrabold">Used by patients taking:</strong> Semaglutide, Tirzepatide, GLP-1 Medications
      </p>

      <BuyButton size="lg" class="mt-6" />
    </div>
  </div>
</section>
