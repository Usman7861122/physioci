---
import Button from '../home/Button.astro';
import CheckCircle from '../CheckCircle.astro';
import SectionHeading from '../home/SectionHeading.astro';
import { collection, slides } from '../../data/home2';
---
<section id="collection" class="bg-gradient-to-b from-[#faf5ec] to-[#f4eadb] px-5 py-16 lg:py-24" aria-labelledby="collection-title">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading title={collection.title} strong={collection.strong} intro={collection.intro} />
    <ul class="mt-10 grid gap-6 md:grid-cols-3" data-stagger>
      {slides.map((p) => (
        <li class="group flex flex-col overflow-hidden rounded-[22px] border border-[#eadfca] bg-white shadow-[0_10px_30px_rgba(90,60,20,0.08)] transition duration-300 hover:-translate-y-2 hover:shadow-[0_22px_44px_rgba(90,60,20,0.18)]">
          <div class="relative overflow-hidden">
            <img src={p.image} alt={p.alt} width="640" height="640" loading="lazy" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <!-- Shows on hover (or keyboard focus, or tap on phones) -->
            <div class="absolute inset-0 flex flex-col justify-center overflow-y-auto hover-tint p-5 opacity-0 transition-opacity duration-300 group-focus-within:opacity-100 group-hover:opacity-100 sm:p-6">
              <p class="font-nunito text-[14px] leading-[1.5] text-white sm:text-[15px]">{p.text}</p>
              <ul class="mt-3 space-y-1.5 hover-line pt-3">
                {p.points.map((pt) => (
                  <li class="flex items-center gap-2 font-nunito text-[14px] font-semibold text-white sm:text-[15px]">
                    <CheckCircle class="h-5 w-5 shrink-0 text-[#fcc461]" />{pt}
                  </li>
                ))}
              </ul>
              <div class="mt-4"><Button href={p.href} variant="light">Learn More</Button></div>
            </div>
          </div>
          <div class="flex flex-1 flex-col p-6 text-center">
            <p class="font-nunito text-[12px] font-bold uppercase tracking-[0.3em] text-[#a67c35]">{p.label}</p>
            <h3 class="mt-1 font-playfair text-[26px] font-medium leading-tight text-black">{p.name}</h3>
            <p class="mt-1 font-nunito text-[16px] font-bold text-gold-dark">{p.lead}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Plain rgba colors (no color-mix) so the tint also shows in older Safari */
  .hover-tint { background: linear-gradient(135deg, rgba(154, 106, 28, 0.86), rgba(110, 67, 10, 0.9)); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45); }
  .hover-tint a { text-shadow: none; }
  .hover-line { border-top: 1px solid rgba(255, 255, 255, 0.35); }
</style>
