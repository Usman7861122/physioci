---
import Button from '../home/Button.astro';
import { bundle } from '../../data/home2';
---
<section id="bundle" class="flex items-center bg-gradient-to-br from-[#f6ecdc] to-[#efdfc4] px-5 py-16" aria-labelledby="bundle-title">
  <div class="mx-auto grid w-full max-w-[1200px] items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">Better together</p>
      <h2 id="bundle-title" class="mt-2 font-jost text-[34px] font-light uppercase leading-[1.05] text-gold-deep sm:text-[50px]">
        GLP-1 Total <strong class="font-semibold">Transformation System</strong><sup class="align-super text-[0.35em]">™</sup>
      </h2>
      <p class="mt-3 font-playfair text-[22px] font-medium leading-snug text-black sm:text-[26px]">{bundle.sub}</p>
      <p class="mt-4 font-nunito text-[17px] font-bold text-gold-dark">{bundle.lead}</p>
      <div class="mt-3 max-w-[540px] space-y-3 font-nunito text-[17px] leading-[1.6] text-[#33333a]">
        {bundle.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-5 max-w-[540px] font-nunito text-[18px] font-extrabold leading-snug text-gold-deep">{bundle.closing}</p>
      <div class="mt-8">
        <Button href={bundle.href}>{bundle.button}</Button>
      </div>
    </div>
    <img
      src={bundle.image}
      alt={bundle.alt}
      width="1000"
      height="1000"
      loading="lazy"
      data-reveal="right"
      class="mx-auto h-auto max-h-[70svh] w-full max-w-[560px] rounded-[22px] object-cover shadow-[0_18px_40px_rgba(90,60,20,0.2)]"
    />
  </div>
</section>
