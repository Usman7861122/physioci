---
import Button from '../home/Button.astro';
import CheckCircle from '../CheckCircle.astro';
interface Props {
  index: number;
  product: { id: string; href: string; image: string; alt: string; label: string; name: string; lead: string; text: string; points: string[] };
}
const { product: p, index } = Astro.props;
const flip = index % 2 === 1;
---
<section id={p.id} class="relative overflow-hidden bg-[#f6eee1]" aria-labelledby={`${p.id}-title`}>
  <div class="mx-auto grid max-w-[1300px] items-stretch lg:min-h-[88svh] lg:grid-cols-2">
    <div class:list={['relative min-h-[360px] overflow-hidden lg:min-h-0', flip && 'lg:order-2']} data-reveal={flip ? 'right' : 'left'}>
      <img src={p.image} alt={p.alt} width="1200" height="1200" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      <div class:list={['absolute inset-y-0 hidden w-24 from-transparent to-[#f6eee1] lg:block', flip ? 'left-0 bg-gradient-to-l' : 'right-0 bg-gradient-to-r']} aria-hidden="true"></div>
    </div>

    <div class="flex flex-col justify-center px-5 py-12 lg:px-12 lg:py-16" data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">{p.label}</p>
      <h2 id={`${p.id}-title`} class="mt-2 font-jost text-[32px] font-light leading-[1.1] text-gold-deep sm:text-[46px]">{p.name}</h2>
      <p class="mt-3 font-nunito text-[18px] font-semibold text-[#33333a]">{p.lead}</p>
      <p class="mt-3 font-nunito text-[16px] leading-[1.6] text-[#33333a]">{p.text}</p>
      <ul class="mt-5">
        {p.points.map((pt) => (
          <li class="flex items-center gap-3 border-t border-gold-deep/30 py-3 font-nunito text-[18px] font-bold text-gold-deep transition-colors duration-300 hover:bg-white/50">
            <CheckCircle class="h-6 w-6 shrink-0 text-gold-deep" />{pt}
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={p.href}>Learn More</Button>
      </div>
    </div>
  </div>
</section>
