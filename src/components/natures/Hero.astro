---
import BuyButton from '../BuyButton.astro';
import NatIcon from './NatIcon.astro';
import { hero } from '../../data/natures';
---
<section class="relative overflow-hidden bg-[#f6ecdc] lg:h-[clamp(720px,56vw,920px)]" aria-labelledby="nat-hero-title">
  <img
    src="/images/natures-glp1/nat-hero.webp"
    alt="Nature’s GLP-1 bottle on a stone shelf beside a glass of water and green leaves"
    width="1676"
    height="939"
    fetchpriority="high"
    class="h-[360px] w-full object-cover object-[80%_center] sm:h-[480px] lg:absolute lg:inset-0 lg:h-full lg:object-center"
  />
  <div class="absolute inset-0 hidden bg-gradient-to-r from-[#f8efe0]/85 via-[#f8efe0]/40 to-transparent lg:block" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[1200px] items-center px-5 py-10 lg:h-full lg:py-14 xl:px-0">
    <div class="max-w-[600px]" data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">{hero.eyebrow}</p>
      <h1 id="nat-hero-title" class="mt-3 font-jost whitespace-nowrap text-[38px] font-light uppercase leading-none text-gold-deep sm:text-[64px]">
        {hero.title}<sup class="align-super text-[0.4em]">™</sup>
      </h1>
      <p class="mt-3 font-nunito text-[19px] text-[#33291d] sm:text-[24px]">{hero.tagline}</p>
      <p class="mt-3 inline-block rounded-md bg-gradient-to-r from-[#efd7a3]/90 to-[#f6e9cd]/60 px-3 py-1 font-nunito text-[16px] text-gold-dark sm:text-[19px]">
        <strong class="font-extrabold">{hero.highlight[0]}</strong>{hero.highlight[1]}<strong class="font-extrabold">{hero.highlight[2]}</strong>{hero.highlight[3]}<strong class="font-extrabold">{hero.highlight[4]}</strong>{hero.highlight[5]}
      </p>
      <p class="mt-3 max-w-[520px] font-nunito text-[16px] leading-[1.5] text-[#5a4524] sm:text-[17px]">{hero.intro}</p>

      <ul class="mt-4 max-w-[400px]">
        {hero.checks.map((c) => (
          <li class="flex items-center gap-3 border-b border-gold-deep/30 py-2.5 transition-transform duration-300 last:border-b-0 hover:translate-x-1.5">
            <NatIcon name={c.icon} class="h-9 w-9 shrink-0 text-gold-deep" />
            <span class="font-nunito text-[20px] text-[#2b2b33] sm:text-[22px]">
              <strong class="font-extrabold text-gold-deep">{c.lead}</strong> {c.strong}
            </span>
          </li>
        ))}
      </ul>

      <BuyButton size="lg" class="mt-6" />
      <p class="mt-3 font-nunito text-[14px] text-[#5a4524]">{hero.note}</p>
    </div>
  </div>
</section>
