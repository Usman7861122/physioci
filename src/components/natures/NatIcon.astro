---
// Simple line icons for the Nature's GLP-1 lists. Drawn as SVG so they stay sharp and match the gold colour.
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 48 48" aria-hidden="true" class={cls} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="24" cy="24" r="21.5" />
  {name === 'drop' && <path d="M24 12c5 6.5 8 10.5 8 14.5a8 8 0 0 1-16 0c0-4 3-8 8-14.5Z" />}
  {name === 'fork' && (
    <Fragment>
      <path d="M17 12v8a3 3 0 0 0 6 0v-8M20 12v24" />
      <path d="M31 36V12c-3 2-4.500 6-4.500 10 0 2.500 1.500 3.500 4.500 3.500" />
    </Fragment>
  )}
  {name === 'cycle' && (
    <Fragment>
      <path d="M33 20a10 10 0 0 0-17.500-3.500L14 19M15 28a10 10 0 0 0 17.500 3.500L34 29" />
      <path d="M14 13v6h6M34 35v-6h-6" />
    </Fragment>
  )}
  {name === 'leaf' && <path d="M14 33c0-11 7-18 20-19 0 13-6 20-17 20M14 33c4-6 8-9 13-12" />}
  {name === 'chart' && <path d="M14 34V28M21 34V22M28 34V17M35 34V12" />}
</svg>
