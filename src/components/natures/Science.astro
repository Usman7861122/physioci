---
import BuyButton from '../BuyButton.astro';
import { science } from '../../data/natures';
---
<section class="relative overflow-hidden bg-[#f6ecdc]" aria-labelledby="nat-science-title">
  <img
    src="/images/natures-glp1/nat-science.webp"
    alt="Nature’s GLP-1 bottle beside red berries, matcha powder and cinnamon, with the words Science Backed by Nature"
    width="1672"
    height="941"
    loading="lazy"
    class="h-[340px] w-full object-cover object-[12%_center] lg:object-[22%_center] sm:h-[460px] lg:absolute lg:inset-0 lg:h-full"
  />
  <div class="relative mx-auto max-w-[1440px] px-5 py-10 lg:py-14">
    <div class="lg:ml-[50%] lg:w-[46%]" data-stagger>
      <p class="font-nunito text-[13px] font-bold uppercase tracking-[0.35em] text-[#a67c35]">{science.eyebrow}</p>
      <h2 id="nat-science-title" class="mt-2 font-jost text-[36px] font-light uppercase leading-[1.04] text-gold-deep sm:text-[52px]">
        {science.title[0]}<br /><strong class="font-semibold">{science.title[1]}</strong>
      </h2>
      <p class="mt-4 font-nunito text-[17px] leading-[1.45] text-[#33333a]">{science.intro}</p>

      <ul class="mt-5">
        {science.items.map((it) => (
          <li class="group flex items-center gap-4 border-t border-gold-deep/30 py-3 transition-colors duration-300 hover:bg-white/40">
            <img
              src={it.icon}
              alt=""
              width="64"
              height="64"
              loading="lazy"
              class="h-[60px] w-[60px] shrink-0 rounded-full object-cover ring-2 ring-gold/70 ring-offset-2 ring-offset-[#f6ecdc] transition-transform duration-300 group-hover:scale-110"
            />
            <div class="font-nunito">
              <h3 class="text-[19px] font-extrabold uppercase leading-tight text-gold-deep sm:text-[21px]">{it.title}</h3>
              <p class="text-[15px] leading-snug text-[#33333a]">{it.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-4 flex flex-col items-center gap-3">
        <BuyButton size="lg" />
        <p class="font-nunito text-[12px] uppercase tracking-[0.3em] text-[#a67c35]">{science.footer}</p>
      </div>
    </div>
  </div>
</section>
